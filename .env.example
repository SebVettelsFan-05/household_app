# Postgres connection string (auto-injected by the Vercel Neon integration).
DATABASE_URL=postgresql://user:pass@host/db

# Google Apps Script /exec URL — used as a write-only mirror sink from the
# server, and as the source for the one-time /api/seed import.
GAS_API_URL=https://script.google.com/macros/s/REPLACE_WITH_YOUR_DEPLOYMENT_ID/exec

# --- Auth ---
# HMAC secret signing the session cookie. Generate with:
#   openssl rand -base64 32
AUTH_SECRET=change_me_to_32_random_bytes

# Shared house password — anyone with the URL + this string gets in via the
# "House password" option on /login.
HOUSE_PASSWORD=change_me

# Google OAuth client (Web application). Create one at
# https://console.cloud.google.com/apis/credentials and add both
#   http://localhost:3000/api/auth/google/callback
#   https://<your-vercel-domain>/api/auth/google/callback
# to its Authorized redirect URIs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
